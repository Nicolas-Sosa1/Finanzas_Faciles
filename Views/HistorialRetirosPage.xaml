<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanzasFaciles.ViewModels"
             xmlns:models="clr-namespace:FinanzasFaciles.Models"
             xmlns:helpers="clr-namespace:FinanzasFaciles.Helpers"
             x:Class="FinanzasFaciles.Views.HistorialRetirosPage"
             x:DataType="viewmodels:HistorialRetirosViewModel"
             Title="Historial de Retiros">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16">
            <Label Text="Período" FontSize="14" />
            <Border Style="{StaticResource FormInputOutline}">
                <Picker Title=""
                        BackgroundColor="Transparent"
                        ItemsSource="{Binding PeriodosDisponibles}"
                        SelectedItem="{Binding PeriodoSeleccionado}"
                        ItemDisplayBinding="{Binding}" />
            </Border>

            
            <Frame Padding="12" HasShadow="True">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Total retirado en el período" FontSize="12" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding TotalRetiradoEnPeriodo, StringFormat='{0:C2}'}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding ProporcionUtilidadRetirada}" FontSize="11" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="{Binding MensajeExito}" TextColor="{AppThemeBinding Light={StaticResource MensajeExitoLight}, Dark={StaticResource MensajeExitoDark}}" FontSize="13"
                   IsVisible="{Binding MostrarMensajeExito}" />

            <Frame IsVisible="{Binding MostrarFormulario}" Padding="16" HasShadow="True"
                   BorderColor="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding TituloFormulario}" FontAttributes="Bold" FontSize="18" />
                    <Label Text="Monto" FontSize="12" />
                    <Entry Placeholder="0.00" Keyboard="Numeric" Text="{Binding MontoTexto}" />
                    <Label Text="Fecha" FontSize="12" />
                    <DatePicker Date="{Binding Fecha}" />
                    <Label Text="Concepto" FontSize="12" />
                    <Entry Placeholder="Descripción" Text="{Binding Concepto}" />
                    <Label Text="{Binding MensajeError}" TextColor="{AppThemeBinding Light={StaticResource MensajeErrorLight}, Dark={StaticResource MensajeErrorDark}}" IsVisible="{Binding TieneError}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Guardar" Command="{Binding GuardarCommand}" />
                        <Button Grid.Column="1" Text="Cancelar" Command="{Binding CerrarFormularioCommand}" Style="{StaticResource FormCancelButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Registro de retiros" Style="{StaticResource SubHeadline}" />
            <CollectionView ItemsSource="{Binding Retiros}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Retiro">
                        <Frame Padding="12" Margin="0,4" HasShadow="True">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Concepto}" FontAttributes="Bold" />
                                    <Label Text="{Binding Monto, StringFormat='{0:C2}'}" FontAttributes="Bold" />
                                    <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" FontSize="12" Style="{StaticResource MutedLabel}" />
                                    <Label Text="{Binding TipoRetiro}" FontSize="12" />
                                    <Label Text="{Binding EstadoPuntoEquilibrioAlMomento, StringFormat='PE al momento: {0}'}"
                                           FontSize="11" Style="{StaticResource MutedLabel}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Button Text="Editar" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}"
                                            CommandParameter="{Binding .}" Padding="8,4" FontSize="12" />
                                    <Button Text="Eliminar" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarCommand}"
                                            CommandParameter="{Binding .}" Padding="8,4" FontSize="12" BackgroundColor="{StaticResource DangerLight}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No hay retiros en el período seleccionado." HorizontalOptions="Center" Margin="0,20" Style="{StaticResource MutedLabel}" />
                </CollectionView.EmptyView>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
