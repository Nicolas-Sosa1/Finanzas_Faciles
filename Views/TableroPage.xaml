<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanzasFaciles.ViewModels"
             xmlns:models="clr-namespace:FinanzasFaciles.Models"
             x:Class="FinanzasFaciles.Views.TableroPage"
             x:DataType="viewmodels:TableroViewModel"
             Title="Tablero de Control">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16">
            <Frame BackgroundColor="{StaticResource BrandDarkBlue}" Padding="16" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Punto de Equilibrio" TextColor="White" FontSize="14" Opacity="0.85" />
                    <Label Text="{Binding TextoPuntoEquilibrio}" TextColor="White" FontSize="22" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>

            <Frame IsVisible="{Binding TieneAlerta}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource WarningCardLight}, Dark={StaticResource WarningCardDark}}"
                   Padding="12"
                   BorderColor="{AppThemeBinding Light={StaticResource WarningCardBorderLight}, Dark={StaticResource WarningCardBorderDark}}">
                <Label Text="{Binding MensajeAlerta}"
                       TextColor="{AppThemeBinding Light={StaticResource WarningCardTextLight}, Dark={StaticResource WarningCardTextDark}}" />
            </Frame>

            <Label Text="Indicadores del período" Style="{StaticResource SubHeadline}" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Frame Grid.Row="0" Grid.Column="0" Padding="12" HasShadow="True">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Costos fijos" FontSize="12" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding TotalCostosFijos, StringFormat='{0:C2}'}" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="0" Grid.Column="1" Padding="12" HasShadow="True">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Utilidad bruta acum." FontSize="12" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding UtilidadBrutaAcumulada, StringFormat='{0:C2}'}" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="1" Grid.Column="0" Padding="12" HasShadow="True">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Capital de operación" FontSize="12" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding CostosDirectosAcumulados, StringFormat='{0:C2}'}" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="1" Grid.Column="1" Padding="12" HasShadow="True">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Efectivo disponible" FontSize="12" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding EfectivoDisponible, StringFormat='{0:C2}'}" FontAttributes="Bold" />
                        <Label Text="{Binding SaldoCaja, StringFormat='(Caja: {0:C2})'}" FontSize="10" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <Label Text="Ingresos del período" Style="{StaticResource SubHeadline}" Margin="0,8,0,0" />
            <CollectionView ItemsSource="{Binding IngresosRecientes}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Ingreso">
                        <Frame Padding="12" Margin="0,4" HasShadow="True">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding NombreActividad}" FontAttributes="Bold" />
                                <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'} · Cant: {Binding Cantidad}" FontSize="12" Style="{StaticResource MutedLabel}" />
                                <Grid ColumnDefinitions="*,*,*">
                                    <Label Grid.Column="0" Text="{Binding MontoTotal, StringFormat='Total: {0:C2}'}" FontSize="12" />
                                    <Label Grid.Column="1" Text="{Binding FondoOperacion, StringFormat='Fdo.Op: {0:C2}'}" FontSize="11" Style="{StaticResource MutedLabel}" />
                                    <Label Grid.Column="2" Text="{Binding UtilidadBruta, StringFormat='Util: {0:C2}'}" FontSize="11" FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No hay ingresos registrados este mes." HorizontalOptions="Center" Margin="0,20" Style="{StaticResource MutedLabel}" />
                </CollectionView.EmptyView>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
