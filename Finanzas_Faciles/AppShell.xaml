<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Finanzas_Faciles.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Finanzas_Faciles.Views"
    Title="Finanzas_Faciles"
    FlyoutBehavior="Flyout"
    Shell.FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource FlyoutBackgroundLight}, Dark={StaticResource FlyoutBackgroundDark}}">

    <Shell.FlyoutHeader>
        <Grid HeightRequest="120" Padding="24,48,24,24"
          BackgroundColor="{AppThemeBinding Light={StaticResource FlyoutHeaderLight}, Dark={StaticResource FlyoutHeaderDark}}">
            <VerticalStackLayout VerticalOptions="End" Spacing="4">
                <Label Text="Finanzas Faciles"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Label Text="Control financiero"
                   FontSize="12"
                   Opacity="0.7"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid HeightRequest="52" 
              Padding="28,0,28,0">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" 
                                        Value="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
                <Label Text="{Binding Title}"
                   FontSize="16"
                   FontAttributes="None"
                   VerticalTextAlignment="Center"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <FlyoutItem Title="Ingresos">
        <ShellContent
        Title="Registro de Ingresos"
        ContentTemplate="{DataTemplate views:IngresosPage}"
        Route="IngresosPage" />
    </FlyoutItem>

    <FlyoutItem Title="Costos Fijos">
        <ShellContent ContentTemplate="{DataTemplate views:GastosFijosPage}" Route="GastosFijosPage" />
    </FlyoutItem>

    <FlyoutItem Title="Actividades">
        <ShellContent ContentTemplate="{DataTemplate views:ActividadesPage}" Route="ActividadesPage" />
    </FlyoutItem>

    <FlyoutItem Title="Retiros">
        <ShellContent
            Title="Retiros"
            ContentTemplate="{DataTemplate views:RetirosPage}"
            Route="RetirosPage" />
    </FlyoutItem>

    <FlyoutItem Title="Historial de Retiros">
        <ShellContent
            Title="Historial de Retiros"
            ContentTemplate="{DataTemplate views:HistorialRetirosPage}"
            Route="HistorialRetirosPage" />
    </FlyoutItem>

</Shell>
