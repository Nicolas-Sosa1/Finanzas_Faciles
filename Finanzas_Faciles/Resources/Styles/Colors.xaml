<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Light y Dark mode -->

    <!-- Primary - Indigo -->
    <Color x:Key="Primary">#4F46E5</Color>
    <Color x:Key="PrimaryDark">#6366F1</Color>
    <Color x:Key="Tertiary">#3730A3</Color>

    <!-- Fondos base -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#0F172A</Color>
    <Color x:Key="OffBlack">#0F172A</Color>
    <Color x:Key="MidnightBlue">#1E293B</Color>

    <!-- Fondos -->
    <Color x:Key="SurfaceLight">#FAFAFA</Color>
    <Color x:Key="SurfaceDark">#0F172A</Color>
    <Color x:Key="FlyoutBackgroundLight">#FFFFFF</Color>
    <Color x:Key="FlyoutBackgroundDark">#0F172A</Color>
    <Color x:Key="FlyoutHeaderLight">#F8FAFC</Color>
    <Color x:Key="FlyoutHeaderDark">#1E293B</Color>

    <!-- Cards, formularios, recuadros internos Light/Dark -->
    <Color x:Key="CardBgLight">#FFFFFF</Color>
    <Color x:Key="CardBgDark">#1E293B</Color>
    <Color x:Key="CardBorderLight">#E2E8F0</Color>
    <Color x:Key="CardBorderDark">#334155</Color>

    <!-- Secciones anidadas (margen/precio fijo dentro de formulario) -->
    <Color x:Key="FormSectionLight">#F1F5F9</Color>
    <Color x:Key="FormSectionDark">#334155</Color>

    <!-- Tinte secundario (precio venta, utilidad en Actividades) -->
    <Color x:Key="SecondaryTintLight">#E0E7FF</Color>
    <Color x:Key="SecondaryTintDark">#3730A3</Color>

    <!-- Card inactivo -->
    <Color x:Key="InactiveCardLight">#E2E8F0</Color>
    <Color x:Key="InactiveCardDark">#334155</Color>

    <!-- Card éxito -->
    <Color x:Key="SuccessCardLight">#D1FAE5</Color>
    <Color x:Key="SuccessCardDark">#064E3B</Color>
    <Color x:Key="SuccessCardTextLight">#059669</Color>
    <Color x:Key="SuccessCardTextDark">#34D399</Color>

    <!-- Card alerta -->
    <Color x:Key="WarningCardLight">#FEF3C7</Color>
    <Color x:Key="WarningCardDark">#78350F</Color>
    <Color x:Key="WarningCardBorderLight">#F59E0B</Color>
    <Color x:Key="WarningCardBorderDark">#D97706</Color>
    <Color x:Key="WarningCardTextLight">#92400E</Color>
    <Color x:Key="WarningCardTextDark">#FDE68A</Color>

    <!-- Texto en ambos modos -->
    <Color x:Key="TextPrimaryLight">#0F172A</Color>
    <Color x:Key="TextPrimaryDark">#F8FAFC</Color>
    <Color x:Key="TextSecondaryLight">#64748B</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>

    <!-- Grises escala slate -->
    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#1E293B</Color>
    <Color x:Key="Gray950">#0F172A</Color>

    <!-- Botón Cancelar -->
    <Color x:Key="CancelButtonLight">#94A3B8</Color>
    <Color x:Key="CancelButtonDark">#475569</Color>

    <!-- Mensajes error/éxito -->
    <Color x:Key="MensajeErrorLight">#DC2626</Color>
    <Color x:Key="MensajeErrorDark">#FCA5A5</Color>
    <Color x:Key="MensajeExitoLight">#059669</Color>
    <Color x:Key="MensajeExitoDark">#34D399</Color>

    <!-- Colores semánticos -->
    <Color x:Key="Secondary">#E0E7FF</Color>
    <Color x:Key="SecondaryDarkText">#CBD5E1</Color>
    <Color x:Key="Magenta">#6366F1</Color>
    <Color x:Key="SuccessGreen">#059669</Color>
    <Color x:Key="SuccessLight">#10B981</Color>
    <Color x:Key="WarningOrange">#D97706</Color>
    <Color x:Key="DangerRed">#DC2626</Color>
    <Color x:Key="DangerLight">#EF4444</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
</ResourceDictionary>
