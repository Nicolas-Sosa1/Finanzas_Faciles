<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Finanzas_Faciles.ViewModels"
             xmlns:models="clr-namespace:Finanzas_Faciles.Models"
             xmlns:helpers="clr-namespace:Finanzas_Faciles.Helpers"
             x:Class="Finanzas_Faciles.Views.HistorialRetirosPage"
             x:DataType="viewmodels:HistorialRetirosViewModel"
             Title="Historial de Retiros">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16">
            <Label Text="Período" FontSize="14" />
            <Picker Title="Seleccionar período"
                    ItemsSource="{Binding PeriodosDisponibles}"
                    SelectedItem="{Binding PeriodoSeleccionado}"
                    ItemDisplayBinding="{Binding}" />

            <Frame Padding="12" HasShadow="True">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Total retirado en el período" FontSize="12" Style="{StaticResource MutedLabel}" />
                    <Label Text="{Binding TotalRetiradoEnPeriodo, StringFormat='{0:C2}'}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding ProporcionUtilidadRetirada}" FontSize="11" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Registro de retiros" Style="{StaticResource SubHeadline}" />
            <CollectionView ItemsSource="{Binding Retiros}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Retiro">
                        <Frame Padding="12" Margin="0,4" HasShadow="True">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Concepto}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding Monto, StringFormat='{0:C2}'}" FontAttributes="Bold" />
                                </Grid>
                                <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" FontSize="12" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding TipoRetiro}" FontSize="12" />
                                <Label Text="{Binding EstadoPuntoEquilibrioAlMomento, StringFormat='PE al momento: {0}'}"
                                       FontSize="11" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No hay retiros en el período seleccionado." HorizontalOptions="Center" Margin="0,20" Style="{StaticResource MutedLabel}" />
                </CollectionView.EmptyView>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
