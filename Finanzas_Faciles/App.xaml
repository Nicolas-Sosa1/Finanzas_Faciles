<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Finanzas_Faciles"
             xmlns:helpers="clr-namespace:Finanzas_Faciles.Helpers"
             x:Class="Finanzas_Faciles.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:BoolToActivoConverter x:Key="BoolToActivoConverter" />
            <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <helpers:EstadoToColorConverter x:Key="EstadoToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
