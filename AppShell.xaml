<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FinanzasFaciles.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FinanzasFaciles.Views"
    xmlns:controls="clr-namespace:FinanzasFaciles.Controls"
    Title="Finanzas Fáciles"
    FlyoutBehavior="Flyout"
    FlyoutWidth="360"
    Shell.FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource FlyoutBackgroundLight}, Dark={StaticResource FlyoutBackgroundDark}}">

    
    <Shell.FlyoutHeader>
        <Grid HeightRequest="140" Padding="20,48,12,16"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="14"
              BackgroundColor="{AppThemeBinding Light={StaticResource FlyoutHeaderLight}, Dark={StaticResource FlyoutHeaderDark}}">
            <Border Grid.Column="0"
                    VerticalOptions="End"
                    HorizontalOptions="Start"
                    WidthRequest="56"
                    HeightRequest="56"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BrandDarkBlue}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Image Source="logo_finanzas.jpg"
                       Aspect="AspectFit"
                       Margin="4" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="2">
                <Label Text="Finanzas Fáciles"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource BrandDarkBlue}, Dark={StaticResource White}}" />
                <Label Text="Control financiero"
                       FontSize="12"
                       Opacity="0.8"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </VerticalStackLayout>
            <Button Grid.Column="2"
                    x:Name="ThemeToggleButton"
                    Text="🌙"
                    FontSize="18"
                    WidthRequest="40"
                    HeightRequest="40"
                    MinimumWidthRequest="40"
                    MinimumHeightRequest="40"
                    Padding="0"
                    CornerRadius="20"
                    VerticalOptions="End"
                    HorizontalOptions="End"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BrandDarkBlue}}"
                    TextColor="{AppThemeBinding Light={StaticResource BrandDarkBlue}, Dark={StaticResource White}}"
                    ToolTipProperties.Text="Cambiar tema"
                    Clicked="OnThemeToggleClicked" />
        </Grid>
    </Shell.FlyoutHeader>

    
    <Shell.ItemTemplate>
        <DataTemplate>
            <controls:FlyoutMenuItemView />
        </DataTemplate>
    </Shell.ItemTemplate>

    
    <Shell.MenuItemTemplate>
        <DataTemplate>
            <controls:FlyoutMenuItemView />
        </DataTemplate>
    </Shell.MenuItemTemplate>

    
    <FlyoutItem Title="Dashboard">
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="DashboardPage" />
    </FlyoutItem>

    <FlyoutItem Title="Ingresos">
        <ShellContent
            Title="Registro de Ingresos"
            ContentTemplate="{DataTemplate views:RegistroIngresosPage}"
            Route="RegistroIngresosPage" />
    </FlyoutItem>

    <FlyoutItem Title="Costos Fijos">
        <ShellContent
            Title="Costos Fijos"
            ContentTemplate="{DataTemplate views:GastoFijosPage}"
            Route="GastoFijosPage" />
    </FlyoutItem>

    <FlyoutItem Title="Actividades">
        <ShellContent
            Title="Actividades"
            ContentTemplate="{DataTemplate views:ActividadesPage}"
            Route="ActividadesPage" />
    </FlyoutItem>

    <FlyoutItem Title="Retiros">
        <ShellContent
            Title="Retiros"
            ContentTemplate="{DataTemplate views:RetirosPage}"
            Route="RetirosPage" />
    </FlyoutItem>

    <FlyoutItem Title="Historial de Retiros">
        <ShellContent
            Title="Historial de Retiros"
            ContentTemplate="{DataTemplate views:HistorialRetirosPage}"
            Route="HistorialRetirosPage" />
    </FlyoutItem>
    
    <FlyoutItem Title="Exportar">
        <ShellContent
        Title="Exportar Reportes"
        ContentTemplate="{DataTemplate views:ExportarPage}"
        Route="ExportarPage" />
    </FlyoutItem>

    <MenuItem Text="Restablecer datos"
              Clicked="OnRestablecerDatosClicked" />

</Shell>
